{
  "$schema": "./silk-os-v0.6/node_modules/wrangler/config-schema.json",
  "name": "assistant-core",
  "main": "silk-os-v0.6/dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "silk-os-v0.6/dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistant-memory",
      "database_id": "1dee7a70-83e5-464d-a96b-d86b5ccdc913"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PRIMARY_AI_PROVIDER": "openai",
    "OPENAI_ROUTER_MODEL": "gpt-5-nano",
    "OPENAI_ROUTINE_MODEL": "gpt-5.6-luna",
    "OPENAI_COMPLEX_MODEL": "gpt-5.6-terra",
    "OPENAI_SPEND_LIMIT_USD": "10"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
